{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx src/resume-engine/tests/run-all.ts",
    "omniroute": "npx omniroute",
    "dev:with-omniroute": "npx concurrently \"npm run dev\" \"npm run omniroute\""
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "latest",
    "@google-cloud/pubsub": "latest",
    "@google/genai": "latest",
    "@napi-rs/canvas": "^1.0.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@tailwindcss/vite": "latest",
    "@types/d3": "latest",
    "@vitejs/plugin-react": "latest",
    "axios": "latest",
    "clsx": "latest",
    "d3": "latest",
    "date-fns": "latest",
    "dompurify": "latest",
    "dotenv": "latest",
    "esbuild": "latest",
    "express": "latest",
    "express-async-errors": "latest",
    "express-rate-limit": "latest",
    "firebase": "latest",
    "firebase-admin": "latest",
    "googleapis": "latest",
    "helmet": "latest",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "mammoth": "latest",
    "motion": "latest",
    "multer": "latest",
    "pdf-parse": "latest",
    "pdfjs-dist": "latest",
    "qdrant-js": "^0.0.1-security",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-joyride": "latest",
    "react-markdown": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "redis": "^6.1.0",
    "stripe": "^22.3.0",
    "tailwind-merge": "latest",
    "tesseract.js": "^7.0.0",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/dompurify": "latest",
