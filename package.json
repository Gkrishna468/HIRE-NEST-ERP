    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.1.0",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
