{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx src/resume-engine/tests/run-all.ts",
    "omniroute": "npx omniroute",
    "dev:with-omniroute": "npx concurrently \"npm run dev\" \"npm run omniroute\""
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
