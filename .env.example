# TODO: PLEASE POPULATE THESE WITH YOUR REAL CREDENTIALS BEFORE GOING LIVE
# --- Core Configuration & Deployment ---
GOOGLE_CLOUD_PROJECT=hirenest-os
# Service Account: Use EITHER FIREBASE_SERVICE_ACCOUNT (full JSON) OR individual fields below
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Universal Firebase Project Constants (Compatible with AI Studio Deployment) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- OAuth Integrations ---
GOOGLE_CLIENT_ID=733294346096-qna6jrvs8vr03qf10hfrdlvt1ndad20t.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://os.hirenestworkforce.com/api/oauth/callback

# --- AI Integration (Google GenAI Two-Tier Architecture) ---
GEMINI_API_KEY=
AI_LEVEL_1_MODEL=gemini-3.1-flash-lite
AI_LEVEL_2_MODEL=gemini-3.7-flash
AI_PRO_MODEL=disabled

# --- Application Meta ---
NODE_ENV=development
ENCRYPTION_KEY=

# --- Scheduled Jobs (Vercel Cron) ---
# Set this and Vercel automatically sends it as `Authorization: Bearer <value>`
# on every scheduled cron request (see vercel.json's "crons" array). Required
# for /api/cron/gmail-watch-renew, /api/cron/mailos-sync, and
# /api/cron/orchestrator/process to run on their own schedule instead of only
# when a signed-in admin triggers them manually.
CRON_SECRET=
# Pub/Sub topic used for Gmail push notifications (see /api/workspace/watch/setup).
# Defaults to "gmail-events" if unset.
PUBSUB_TOPIC_NAME=gmail-events

# --- WhatsApp Cloud API ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set in the Meta App Dashboard when registering the webhook URL
# (https://<your-domain>/api/workspace/whatsapp/webhook) — must match what
# you type into Meta's "Verify Token" field exactly.
WHATSAPP_VERIFY_TOKEN=
# Optional but recommended: your Meta App's "App Secret" (not the API
# token). When set, inbound webhook payloads are verified against the
# X-Hub-Signature-256 header Meta sends; when unset, signature verification
# is skipped (matching this codebase's existing pattern of not hard-failing
# an integration that hasn't been fully configured yet).
WHATSAPP_APP_SECRET=

# --- Ollama Integration (optional local model health-check only; nothing in
#     this codebase actually routes inference through Ollama yet) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Internal API Key (used by authMiddleware.ts as an alternate to Firebase
#     auth for trusted server-to-server calls) ---
HIRENEST_API_KEY=HN_dev_key_123

# --- n8n Workflow Automation Integrations ---
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_RESUME_SCREENING_WEBHOOK=
N8N_CANDIDATE_MATCH_WEBHOOK=
N8N_FIRESTORE_EVENT_WEBHOOK=
